{
  "name": "hanmark",
  "version": "2.4.2",
  "description": "No-setup Markdown, images, and reusable semantic templates to HWPX with bundled Kordoc.",
  "main": "main.js",
  "scripts": {
    "gen-assets": "node scripts/gen-embedded-assets.mjs",
    "dev": "node scripts/gen-embedded-assets.mjs && node esbuild.config.mjs",
    "build": "node scripts/gen-embedded-assets.mjs && tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import tsx --test tests/*.test.ts",
    "check-bundle": "node scripts/check-bundle.mjs",
    "check": "npm run test && npm run build && npm run check-bundle"
  },
  "keywords": [
    "hwp",
    "hwpx",
    "docx",
    "markdown",
    "kordoc"
  ],
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "jszip": "^3.10.1",
    "kordoc": "4.2.5",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.1",
    "obsidian": "^1.5.0",
    "tslib": "^2.8.1",
    "tsx": "4.21.0",
    "typescript": "^5.8.2"
  }
}
