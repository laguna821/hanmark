{
  "name": "hanmark",
  "version": "2.4.3",
  "description": "No-setup Markdown, images, and reusable semantic templates to HWPX with bundled Kordoc.",
  "main": "main.js",
  "scripts": {
    "gen-assets": "node scripts/gen-embedded-assets.mjs",
    "dev": "node scripts/gen-embedded-assets.mjs && node esbuild.config.mjs",
    "build": "node scripts/gen-embedded-assets.mjs && tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint src package.json manifest.json --max-warnings 0",
    "check-bundle": "node scripts/check-bundle.mjs",
    "check-community": "node scripts/check-community.mjs",
    "check-release": "node scripts/check-release.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run check-bundle && npm run check-community && npm run check-release"
  },
  "keywords": [
    "hwp",
    "hwpx",
    "docx",
    "markdown",
    "kordoc"
  ],
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.8.10",
    "docx-preview": "0.4.0",
    "jszip": "^3.10.1",
    "kordoc": "4.2.5",
    "pdfjs-dist": "4.10.38"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "adm-zip": "0.6.0",
    "body-parser": "2.3.0",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.4",
    "hono": "4.12.31",
    "protobufjs": "8.7.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@eslint/json": "0.14.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "8.65.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.1",
    "obsidian": "^1.5.0",
    "tslib": "^2.8.1",
    "tsx": "4.21.0",
    "typescript": "^5.8.2"
  }
}
