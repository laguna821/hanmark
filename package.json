{
  "name": "hanmark",
  "version": "3.0.0",
  "description": "No-setup Markdown export to HWPX, DOCX, self-contained HTML, and Editorial PDF.",
  "main": "main.js",
  "scripts": {
    "gen-assets": "node scripts/gen-embedded-assets.mjs && node scripts/gen-hayro-wasm.mjs && node scripts/gen-form-templates.mjs && node scripts/gen-font-css.mjs",
    "dev": "npm run gen-assets && node esbuild.config.mjs",
    "build": "npm run gen-assets && tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "test:pdf-palette-exhaustive": "node --import tsx scripts/check-pdf-palette-exhaustive.ts",
    "lint": "eslint src package.json manifest.json --max-warnings 0",
    "check-bundle": "node scripts/check-bundle.mjs",
    "check-community": "node scripts/check-community.mjs",
    "check-release": "node scripts/check-release.mjs",
    "check-i18n": "node scripts/check-i18n.mjs",
    "check": "npm run lint && npm run check-i18n && npm run test && npm run build && npm run check-bundle && npm run check-community && npm run check-release",
    "test:pdf-render": "node --import tsx scripts/test-editorial-pdf-render.mjs",
    "test:pdf-ui": "node scripts/test-pdf-export-ui.mjs",
    "test:check-ui": "node scripts/test-gongmun-check-ui.mjs",
    "test:form-ui": "node scripts/test-gongmun-form-ui.mjs",
    "test:import-ui": "node scripts/test-import-ui.mjs",
    "test:docx-writer": "node --import tsx scripts/test-docx-writer.mjs",
    "test:diagram-exports": "node scripts/test-diagram-exports.mjs",
    "test:hwp-convert": "node --import tsx scripts/test-hwp-convert.mjs",
    "test:hwp-convert-ui": "node scripts/test-hwp-convert-ui.mjs",
    "test:toolbar-ui": "node scripts/test-toolbar-ui.mjs",
    "test:preview-ui": "node scripts/test-preview-ui.mjs",
    "test:sample-look-ui": "node --import tsx scripts/test-sample-look-ui.mjs",
    "test:sample-looks": "node --import tsx scripts/test-sample-looks.ts",
    "test:pdf-look": "node --import tsx scripts/test-pdf-look.ts"
  },
  "keywords": [
    "hwp",
    "hwpx",
    "docx",
    "markdown",
    "kordoc"
  ],
  "license": "MIT",
  "dependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "docx-preview": "0.4.0",
    "jszip": "^3.10.1",
    "kordoc": "4.25.0",
    "markdown-it": "14.3.3",
    "markdown-it-footnote": "4.0.0",
    "pele": "1.13.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "moment": "2.31.0"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/json": "0.14.0",
    "@fontsource/pretendard": "5.3.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "8.65.0",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.1",
    "obsidian": "^1.5.0",
    "pdfjs-dist": "4.10.38",
    "playwright": "1.62.1",
    "tslib": "^2.8.1",
    "tsx": "4.21.0",
    "typescript": "^5.8.2"
  }
}
